{
  "name": "bic-archiver",
  "version": "0.3.0",
  "description": "Desktop app for archiving NFT metadata and media to verifiable IPFS .car backups",
  "main": "./out/main/index.js",
  "author": "BIC",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:lifecycle": "electron-vite build && electron scripts/lifecycle-probe.mjs",
    "build:lib": "esbuild scripts/lib-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=out-lib/index.js",
    "inspect": "npm run build:lib --silent && node scripts/inspect-car.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "@ipld/dag-pb": "^4.1.7",
    "blockstore-core": "^7.0.1",
    "blockstore-fs": "^4.0.1",
    "interface-blockstore": "^7.0.1",
    "ipfs-unixfs": "^12.0.1",
    "ipfs-unixfs-exporter": "^16.0.2",
    "ipfs-unixfs-importer": "^17.0.1",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "org.bic.archiver",
    "productName": "BIC Archiver",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "resources/icon.png"
    }
  }
}
